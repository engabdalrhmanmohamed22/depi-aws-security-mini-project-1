# Terraform state - NEVER commit, contains secrets in clear text
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Variable files that may contain personal/sensitive values
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# OS / editor junk
.DS_Store
*.swp

# Lambda build artifacts
terraform/lambda/*.zip
